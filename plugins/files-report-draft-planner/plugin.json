{
  "name": "files-report-draft-planner",
  "display_name": "Report Draft Planner",
  "description": "Report Draft Planner for Hermes Agent: apply a prioritize workflow to report draft work \u2014 covers format fit, completeness and output location, using supplied facts only.",
  "category": "File & Document Work",
  "domain": "Hermes Agent",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "files_report_draft_planner",
      "description": "Report Draft Planner for Hermes Agent: apply a prioritize workflow to report draft work \u2014 covers format fit, completeness and output location, using supplied facts only.",
      "kind": "prioritize",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "items": [
          {
            "name": "Sample task A",
            "impact": 8,
            "effort": 3
          },
          {
            "name": "Sample task B",
            "impact": 6,
            "effort": 1
          }
        ]
      },
      "output": {
        "plugin": "files-report-draft-planner",
        "tool": "files_report_draft_planner",
        "kind": "prioritize",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "prioritize",
    "config": {
      "items": [
        "report draft format fit",
        "report draft completeness",
        "report draft naming consistency",
        "report draft source fidelity",
        "report draft output location"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "file"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "file & document work",
    "hermes",
    "prioritize"
  ]
}