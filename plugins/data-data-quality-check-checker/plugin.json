  "tools": [
    {
      "name": "data_data_quality_check_checker",
      "description": "Data Quality Check Checker for Hermes Agent: apply a template workflow to data quality check work \u2014 covers data completeness, column consistency and format fit, using supplied facts only.",
      "kind": "template",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "facts": {
          "data_quality_check_data_completeness": "Sample supplied fact",
          "data_quality_check_column_consistency": "Second supplied fact"
        }
      },
      "output": {
        "plugin": "data-data-quality-check-checker",
        "tool": "data_data_quality_check_checker",
        "kind": "template",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "template",
    "config": {
      "items": [
        "data quality check data completeness",
        "data quality check column consistency",
        "data quality check outliers flagged",
        "data quality check totals verified",
        "data quality check format fit"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "file"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "data & spreadsheets",
    "hermes",
    "template"
  ]
}