      "kind": "checklist",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "completed": [
          "secret handling check risk identified",
          "secret handling check approval required"
        ]
      },
      "output": {
        "plugin": "safety-secret-handling-check-gate",
        "tool": "safety_secret_handling_check_gate",
        "kind": "checklist",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "checklist",
    "config": {
      "items": [
        "secret handling check risk identified",
        "secret handling check approval required",
        "secret handling check least privilege",
        "secret handling check reversibility",
        "secret handling check audit logged"
      ]
