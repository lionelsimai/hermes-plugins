      "description": "Cross Platform Post Drafter for Hermes Agent: apply a prioritize workflow to cross platform post work \u2014 covers audience fit, tone fit and platform fit, using supplied facts only.",
      "kind": "prioritize",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "items": [
          {
            "name": "Sample task A",
            "impact": 8,
            "effort": 3
          },
          {
            "name": "Sample task B",
            "impact": 6,
            "effort": 1
          }
        ]
      },
      "output": {
        "plugin": "messaging-cross-platform-post-drafter",
        "tool": "messaging_cross_platform_post_drafter",
        "kind": "prioritize",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "prioritize",
    "config": {
      "items": [
        "cross platform post audience fit",
        "cross platform post tone fit",
        "cross platform post length fit",
        "cross platform post approval gate",
        "cross platform post platform fit"
      ]
