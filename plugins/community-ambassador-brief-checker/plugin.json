{
  "name": "community-ambassador-brief-checker",
  "display_name": "Ambassador Brief Checker",
  "description": "Ambassador Brief Checker for Hermes Agent: apply a template workflow to ambassador brief work \u2014 covers member fit, tone fit and follow up named, using supplied facts only.",
  "category": "Community Ops",
  "domain": "Hermes Agent",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "community_ambassador_brief_checker",
      "description": "Ambassador Brief Checker for Hermes Agent: apply a template workflow to ambassador brief work \u2014 covers member fit, tone fit and follow up named, using supplied facts only.",
      "kind": "template",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "facts": {
          "ambassador_brief_member_fit": "Sample supplied fact",
          "ambassador_brief_tone_fit": "Second supplied fact"
        }
      },
      "output": {
        "plugin": "community-ambassador-brief-checker",
        "tool": "community_ambassador_brief_checker",
        "kind": "template",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "template",
    "config": {
      "items": [
        "ambassador brief member fit",
        "ambassador brief tone fit",
        "ambassador brief approval gate",
        "ambassador brief safety check",
        "ambassador brief follow up named"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "messaging"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "community ops",
    "hermes",
    "template"
  ]
}