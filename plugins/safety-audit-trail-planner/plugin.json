  "tools": [
    {
      "name": "safety_audit_trail_planner",
      "description": "Audit Trail Planner for Hermes Agent: apply a classify workflow to audit trail work \u2014 covers risk identified, approval required and audit logged, using supplied facts only.",
      "kind": "classify",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "text": "Please review: this concerns audit trail risk identified and audit trail least privilege."
      },
      "output": {
        "plugin": "safety-audit-trail-planner",
        "tool": "safety_audit_trail_planner",
        "kind": "classify",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "classify",
    "config": {
      "items": [
        "audit trail risk identified",
        "audit trail approval required",
        "audit trail least privilege",
        "audit trail reversibility",
        "audit trail audit logged"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "skills"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "safety, approvals & guardrails",
    "hermes",
    "classify"
  ]
