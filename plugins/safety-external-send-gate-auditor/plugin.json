      "description": "External Send Gate Auditor for Hermes Agent: apply a score workflow to external send gate work \u2014 covers risk identified, approval required and audit logged, using supplied facts only.",
      "kind": "score",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "metrics": {
          "external_send_gate_risk_identified": 80,
          "external_send_gate_approval_required": 65,
          "external_send_gate_least_privilege": 90
        }
      },
      "output": {
        "plugin": "safety-external-send-gate-auditor",
        "tool": "safety_external_send_gate_auditor",
        "kind": "score",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "score",
    "config": {
      "items": [
        "external send gate risk identified",
        "external send gate approval required",
        "external send gate least privilege",
        "external send gate reversibility",
        "external send gate audit logged"
      ]
