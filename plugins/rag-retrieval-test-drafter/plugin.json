{
  "name": "rag-retrieval-test-drafter",
  "display_name": "Retrieval Test Drafter",
  "description": "Retrieval Test Drafter for Hermes Agent: apply a score workflow to retrieval test work \u2014 covers source fidelity, retrieval relevance and gap honesty, using supplied facts only.",
  "category": "Knowledge & RAG",
  "domain": "Hermes Agent",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "rag_retrieval_test_drafter",
      "description": "Retrieval Test Drafter for Hermes Agent: apply a score workflow to retrieval test work \u2014 covers source fidelity, retrieval relevance and gap honesty, using supplied facts only.",
      "kind": "score",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "metrics": {
          "retrieval_test_source_fidelity": 80,
          "retrieval_test_retrieval_relevance": 65,
          "retrieval_test_citation_coverage": 90
        }
      },
      "output": {
        "plugin": "rag-retrieval-test-drafter",
        "tool": "rag_retrieval_test_drafter",
        "kind": "score",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "score",
    "config": {
      "items": [
        "retrieval test source fidelity",
        "retrieval test retrieval relevance",
        "retrieval test citation coverage",
        "retrieval test freshness",
        "retrieval test gap honesty"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "memory"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "knowledge & rag",
    "hermes",
    "score"
  ]
}