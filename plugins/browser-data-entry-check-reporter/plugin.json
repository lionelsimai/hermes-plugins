            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "counts": {
          "data_entry_check_step_clarity": 40,
          "data_entry_check_fallback_step": 25,
