        "series": [
          3,
          5,
          4,
          8
        ]
      },
      "output": {
        "plugin": "browser-data-entry-check-reporter",
        "tool": "browser_data_entry_check_reporter",
        "kind": "analyze",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
