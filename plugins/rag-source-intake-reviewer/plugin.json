{
  "name": "rag-source-intake-reviewer",
  "display_name": "Source Intake Reviewer",
  "description": "Source Intake Reviewer for Hermes Agent: apply a score workflow to source intake work \u2014 covers source fidelity, retrieval relevance and gap honesty, using supplied facts only.",
  "category": "Knowledge & RAG",
  "domain": "Hermes Agent",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "rag_source_intake_reviewer",
      "description": "Source Intake Reviewer for Hermes Agent: apply a score workflow to source intake work \u2014 covers source fidelity, retrieval relevance and gap honesty, using supplied facts only.",
      "kind": "score",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "metrics": {
          "source_intake_source_fidelity": 80,
          "source_intake_retrieval_relevance": 65,
          "source_intake_citation_coverage": 90
        }
      },
      "output": {
        "plugin": "rag-source-intake-reviewer",
        "tool": "rag_source_intake_reviewer",
        "kind": "score",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "score",
    "config": {
      "items": [
        "source intake source fidelity",
        "source intake retrieval relevance",
        "source intake citation coverage",
        "source intake freshness",
        "source intake gap honesty"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "memory"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "knowledge & rag",
    "hermes",
    "score"
  ]
}