  "tools": [
    {
      "name": "web_documentation_lookup_tracker",
      "description": "Documentation Lookup Tracker for Hermes Agent: apply a analyze workflow to documentation lookup work \u2014 covers source quality, recency and scope fit, using supplied facts only.",
      "kind": "analyze",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "counts": {
          "documentation_lookup_source_quality": 40,
          "documentation_lookup_recency": 25,
          "documentation_lookup_corroboration": 10,
          "documentation_lookup_citation_completeness": 75
        },
        "series": [
          3,
          5,
          4,
          8
        ]
      },
      "output": {
        "plugin": "web-documentation-lookup-tracker",
        "tool": "web_documentation_lookup_tracker",
        "kind": "analyze",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "analyze",
    "config": {
      "items": [
        "documentation lookup source quality",
        "documentation lookup recency",
        "documentation lookup corroboration",
        "documentation lookup citation completeness",
        "documentation lookup scope fit"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "web"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
