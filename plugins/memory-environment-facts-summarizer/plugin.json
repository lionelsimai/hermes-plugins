  "tools": [
    {
      "name": "memory_environment_facts_summarizer",
      "description": "Environment Facts Summarizer for Hermes Agent: apply a prioritize workflow to environment facts work \u2014 covers fact accuracy, size budget fit and source noted, using supplied facts only.",
      "kind": "prioritize",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "items": [
          {
            "name": "Sample task A",
            "impact": 8,
            "effort": 3
          },
          {
            "name": "Sample task B",
            "impact": 6,
            "effort": 1
          }
        ]
      },
      "output": {
        "plugin": "memory-environment-facts-summarizer",
        "tool": "memory_environment_facts_summarizer",
        "kind": "prioritize",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "prioritize",
    "config": {
      "items": [
        "environment facts fact accuracy",
        "environment facts size budget fit",
        "environment facts staleness",
        "environment facts duplication",
        "environment facts source noted"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "memory"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "memory & context",
    "hermes",
    "prioritize"
  ]
