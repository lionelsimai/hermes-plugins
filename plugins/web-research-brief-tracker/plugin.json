{
  "name": "web-research-brief-tracker",
  "display_name": "Research Brief Tracker",
  "description": "Research Brief Tracker for Hermes Agent: apply a audit workflow to research brief work \u2014 covers source quality, recency and scope fit, using supplied facts only.",
  "category": "Web Research & Browsing",
  "domain": "Hermes Agent",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "web_research_brief_tracker",
      "description": "Research Brief Tracker for Hermes Agent: apply a audit workflow to research brief work \u2014 covers source quality, recency and scope fit, using supplied facts only.",
      "kind": "audit",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "text": "This sample covers research brief source quality and research brief recency in detail."
      },
      "output": {
        "plugin": "web-research-brief-tracker",
        "tool": "web_research_brief_tracker",
        "kind": "audit",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "audit",
    "config": {
      "items": [
        "research brief source quality",
        "research brief recency",
        "research brief corroboration",
        "research brief citation completeness",
        "research brief scope fit"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "web"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "web research & browsing",
    "hermes",
    "audit"
  ]
}