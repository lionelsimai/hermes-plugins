          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "text": "Please review: this concerns rest endpoint test contract fit and rest endpoint test error cases covered."
      },
      "output": {
        "plugin": "api-rest-endpoint-test-mapper",
