  "tools": [
    {
      "name": "media_subtitle_draft_planner",
      "description": "Subtitle Draft Planner for Hermes Agent: apply a score workflow to subtitle draft work \u2014 covers brief clarity, format spec and approval gate, using supplied facts only.",
      "kind": "score",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "metrics": {
          "subtitle_draft_brief_clarity": 80,
          "subtitle_draft_format_spec": 65,
          "subtitle_draft_rights_and_consent": 90
        }
      },
      "output": {
        "plugin": "media-subtitle-draft-planner",
        "tool": "media_subtitle_draft_planner",
        "kind": "score",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "score",
    "config": {
      "items": [
        "subtitle draft brief clarity",
        "subtitle draft format spec",
        "subtitle draft rights and consent",
        "subtitle draft quality gate",
        "subtitle draft approval gate"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "media"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "media (image audio video)",
    "hermes",
    "score"
  ]
}