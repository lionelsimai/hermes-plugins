{
  "name": "media-subtitle-draft-planner",
  "display_name": "Subtitle Draft Planner",
  "description": "Subtitle Draft Planner for Hermes Agent: apply a score workflow to subtitle draft work \u2014 covers brief clarity, format spec and approval gate, using supplied facts only.",
  "category": "Media (Image Audio Video)",
  "domain": "Hermes Agent",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
