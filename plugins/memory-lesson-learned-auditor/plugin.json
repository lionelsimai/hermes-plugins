{
  "name": "memory-lesson-learned-auditor",
  "display_name": "Lesson Learned Auditor",
  "description": "Lesson Learned Auditor for Hermes Agent: apply a analyze workflow to lesson learned work \u2014 covers fact accuracy, size budget fit and source noted, using supplied facts only.",
  "category": "Memory & Context",
  "domain": "Hermes Agent",
  "version": "1.0.0",
  "author": {
    "name": "Lionel Sim",
    "url": "https://sg.linkedin.com/in/lionelshen"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "memory_lesson_learned_auditor",
      "description": "Lesson Learned Auditor for Hermes Agent: apply a analyze workflow to lesson learned work \u2014 covers fact accuracy, size budget fit and source noted, using supplied facts only.",
      "kind": "analyze",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "counts": {
          "lesson_learned_fact_accuracy": 40,
          "lesson_learned_size_budget_fit": 25,
          "lesson_learned_staleness": 10,
          "lesson_learned_duplication": 75
        },
        "series": [
          3,
          5,
          4,
          8
        ]
      },
      "output": {
        "plugin": "memory-lesson-learned-auditor",
        "tool": "memory_lesson_learned_auditor",
        "kind": "analyze",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "analyze",
    "config": {
      "items": [
        "lesson learned fact accuracy",
        "lesson learned size budget fit",
        "lesson learned staleness",
        "lesson learned duplication",
        "lesson learned source noted"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "memory"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "memory & context",
    "hermes",
    "analyze"
  ]
}