  "tools": [
    {
      "name": "core_skill_draft_auditor",
      "description": "Skill Draft Auditor for Hermes Agent: apply a template workflow to skill draft work \u2014 covers goal clarity, setup completeness and verification step, using supplied facts only.",
      "kind": "template",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "facts": {
          "skill_draft_goal_clarity": "Sample supplied fact",
          "skill_draft_setup_completeness": "Second supplied fact"
        }
      },
      "output": {
        "plugin": "core-skill-draft-auditor",
        "tool": "core_skill_draft_auditor",
        "kind": "template",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "template",
    "config": {
      "items": [
        "skill draft goal clarity",
        "skill draft setup completeness",
        "skill draft toolset fit",
        "skill draft guardrail coverage",
        "skill draft verification step"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "skills"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "core agent ops & skill authoring",
    "hermes",
    "template"
  ]
