  "license": "MIT",
  "tools": [
    {
      "name": "web_source_shortlist_verifier",
      "description": "Source Shortlist Verifier for Hermes Agent: apply a analyze workflow to source shortlist work \u2014 covers source quality, recency and scope fit, using supplied facts only.",
      "kind": "analyze",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          },
          "amounts": {
            "type": "object"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "object"
          },
          "items": {
            "type": "array"
          },
          "goal": {
            "type": "string"
          },
          "timeframe_days": {
            "type": "integer"
          }
        },
        "required": []
      },
      "sample_input": {
        "counts": {
          "source_shortlist_source_quality": 40,
          "source_shortlist_recency": 25,
          "source_shortlist_corroboration": 10,
          "source_shortlist_citation_completeness": 75
        },
        "series": [
          3,
          5,
          4,
          8
        ]
      },
      "output": {
        "plugin": "web-source-shortlist-verifier",
        "tool": "web_source_shortlist_verifier",
        "kind": "analyze",
        "result": "object (shape varies by kind, see README)",
        "guardrails": "object \u2014 present on every result"
      }
    }
  ],
  "handler": {
    "type": "analyze",
    "config": {
      "items": [
        "source shortlist source quality",
        "source shortlist recency",
        "source shortlist corroboration",
        "source shortlist citation completeness",
        "source shortlist scope fit"
      ]
    }
  },
  "hermes": {
    "skill": "SKILL.md in this folder (agentskills.io format)",
    "plugin_manifest": "plugin.yaml in this folder (verified Hermes plugin format)",
    "suggested_toolset": "web"
  },
  "guardrails": {
    "no_fabrication": true,
    "draft_only_for_generative_tools": true,
    "human_approval_required": true,
    "no_auto_send": true,
    "use_supplied_facts_only": true,
    "no_credential_handling": true
  },
  "keywords": [
    "web research & browsing",
    "hermes",
    "analyze"
